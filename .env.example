# ─────────────────────────────────────────────────────────────────────────────
# FixFlow environment template.
#   `node infrastructure/scripts/init-env.mjs` copies this to `.env` and replaces
#   every value containing "change-me" with a strong random secret.
# Never commit `.env`.  All values below are LOCAL DEVELOPMENT defaults.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── PostgreSQL (runs in Docker; bound to 127.0.0.1 only) ─────────────────────
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
FIXFLOW_OWNER_PASSWORD=change-me-owner
FIXFLOW_APP_PASSWORD=change-me-app
FIXFLOW_SYSTEM_PASSWORD=change-me-system

# Superuser: only used to create roles/databases (idempotent bootstrap).
DATABASE_SUPERUSER_URL=postgresql://postgres:${POSTGRES_SUPERUSER_PASSWORD}@localhost:${POSTGRES_PORT}/postgres
# Owner role: runs migrations (DDL). Never used by the running app.
DATABASE_OWNER_URL=postgresql://fixflow_owner:${FIXFLOW_OWNER_PASSWORD}@localhost:${POSTGRES_PORT}/fixflow
# App role: used for every tenant request. NOBYPASSRLS → row-level security enforced.
DATABASE_URL=postgresql://fixflow_app:${FIXFLOW_APP_PASSWORD}@localhost:${POSTGRES_PORT}/fixflow
# System role: BYPASSRLS. Only for audited cross-tenant paths (login lookup, QR token resolution, worker sweeps).
DATABASE_SYSTEM_URL=postgresql://fixflow_system:${FIXFLOW_SYSTEM_PASSWORD}@localhost:${POSTGRES_PORT}/fixflow

# Integration tests use a separate database so they never touch dev data.
TEST_DATABASE_OWNER_URL=postgresql://fixflow_owner:${FIXFLOW_OWNER_PASSWORD}@localhost:${POSTGRES_PORT}/fixflow_test
TEST_DATABASE_URL=postgresql://fixflow_app:${FIXFLOW_APP_PASSWORD}@localhost:${POSTGRES_PORT}/fixflow_test
TEST_DATABASE_SYSTEM_URL=postgresql://fixflow_system:${FIXFLOW_SYSTEM_PASSWORD}@localhost:${POSTGRES_PORT}/fixflow_test

# ── Redis (BullMQ, rate limits, realtime adapter) ────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0
TEST_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/1

# ── Object storage (MinIO locally, any S3-compatible service in production) ──
MINIO_ROOT_USER=fixflow-minio
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fixflow-private
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_FORCE_PATH_STYLE=true

# ── Email (Mailpit catches everything locally: http://localhost:8025) ────────
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="FixFlow <no-reply@fixflow.local>"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-jwt-access-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ── URLs ─────────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000
APP_WEB_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# ── Logging / seed ───────────────────────────────────────────────────────────
LOG_LEVEL=info
# Demo seed refuses to run when NODE_ENV=production unless this is explicitly true.
ALLOW_DEMO_SEED=false
