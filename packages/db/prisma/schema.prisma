// FixFlow database schema — PostgreSQL 17, Prisma 7.
//
// Tenancy model (see docs/DATABASE.md and docs/SECURITY.md):
//  * Every tenant-owned table carries `organization_id` and has row-level security policies
//    (migration `rls_policies`) keyed on the transaction-local setting `app.org_id`.
//  * Parent tenant tables expose UNIQUE(organization_id, id); children reference them through
//    COMPOSITE foreign keys (organization_id, x_id) → (organization_id, id). The database itself
//    therefore rejects any row that points at another organization's data.
//  * People referenced in a tenant role (requester, assignee) are linked through
//    Membership(organization_id, user_id) so they must belong to the same organization.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ORG_ADMIN
  MANAGER
  TECHNICIAN
  REQUESTER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum Industry {
  EDUCATION
  HEALTHCARE
  RESIDENTIAL
  OFFICE
  MANUFACTURING
  RETAIL
  HOSPITALITY
  OTHER
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  PENDING_VERIFICATION
  RESOLVED
  CLOSED
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum WorkOrderSource {
  WEB
  QR
  GUEST_QR
  SCHEDULED
}

enum AssetStatus {
  OPERATIONAL
  NEEDS_ATTENTION
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

enum LocationType {
  SITE
  BUILDING
  FLOOR
  ROOM
  AREA
}

enum AttachmentKind {
  REPORT
  PROGRESS
  EVIDENCE
}

enum AssignmentMethod {
  MANUAL
  AUTO
  SELF
}

enum SubmissionOutcome {
  PENDING
  APPROVED
  REJECTED
}

enum SlaEventType {
  RESPONSE_WARNING
  RESPONSE_BREACH
  RESOLUTION_WARNING
  RESOLUTION_BREACH
}

enum NotificationType {
  WORK_ORDER_CREATED
  WORK_ORDER_ASSIGNED
  WORK_ORDER_STATUS_CHANGED
  WORK_ORDER_COMMENT
  RESOLUTION_SUBMITTED
  RESOLUTION_APPROVED
  RESOLUTION_REJECTED
  SLA_WARNING
  SLA_BREACH
  INVITATION
  SCHEDULED_MAINTENANCE
}

enum AutoAssignMode {
  OFF
  SUGGEST
  AUTO
}

enum QrReportingMode {
  AUTHENTICATED
  PUBLIC
}

enum FrequencyUnit {
  DAY
  WEEK
  MONTH
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  DEAD
}

enum UserTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// ──────────────────────────── Identity ───────────────────────────

/// Global person record. Not tenant-scoped: one user can belong to several organizations.
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(254)
  name            String    @db.VarChar(80)
  passwordHash    String    @map("password_hash")
  phone           String?   @db.VarChar(32)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        Membership[]
  sessions           Session[]
  tokens             UserToken[]
  invitationsSent    Invitation[]             @relation("InvitedBy")
  assignmentsMade    WorkOrderAssignment[]    @relation("AssignedBy")
  statusChanges      WorkOrderStatusHistory[]
  comments           WorkOrderComment[]
  checklistCompleted WorkOrderChecklistItem[]
  attachments        Attachment[]
  submissions        ResolutionSubmission[]   @relation("SubmittedBy")
  reviews            ResolutionSubmission[]   @relation("ReviewedBy")
  notifications      Notification[]
  preferences        NotificationPreference[]
  auditLogs          AuditLog[]
  idempotencyRecords IdempotencyRecord[]

  @@map("users")
}

/// Refresh-token session. The raw token is never stored, only its SHA-256 hash.
/// Rotation keeps `familyId`; presenting an already-rotated token revokes the whole family.
model Session {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  familyId             String    @map("family_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.Char(64)
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  userAgent            String?   @map("user_agent") @db.VarChar(300)
  ip                   String?   @db.VarChar(64)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedAt            DateTime? @map("rotated_at") @db.Timestamptz(3)
  lastUsedAt           DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Single-use, hashed, expiring tokens for password reset and email verification.
model UserToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      UserTokenType
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

// ──────────────────────────── Tenancy ────────────────────────────

model Organization {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String          @db.VarChar(100)
  slug                  String          @unique @db.VarChar(64)
  industry              Industry
  timezone              String          @db.VarChar(64)
  /// Per-organization counter backing human-friendly numbers (WO-0042).
  workOrderSeq          Int             @default(0) @map("work_order_seq")
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at") @db.Timestamptz(3)
  // Policy toggles (all editable in Settings → Team permissions / Workflow).
  requesterCanVerify          Boolean         @default(true) @map("requester_can_verify")
  technicianSelfAssign        Boolean         @default(false) @map("technician_self_assign")
  requesterSeesAllOrgRequests Boolean         @default(false) @map("requester_sees_all_org_requests")
  requireEvidencePhoto        Boolean         @default(true) @map("require_evidence_photo")
  reopenWindowDays            Int             @default(7) @map("reopen_window_days")
  autoCloseDays               Int             @default(7) @map("auto_close_days")
  autoAssignMode              AutoAssignMode  @default(SUGGEST) @map("auto_assign_mode")
  qrReportingMode             QrReportingMode @default(AUTHENTICATED) @map("qr_reporting_mode")
  createdAt                   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        Membership[]
  invitations        Invitation[]
  sessions           Session[]
  skills             TechnicianSkill[]
  locations          Location[]
  categories         Category[]
  assets             Asset[]
  checklistTemplates ChecklistTemplate[]
  checklistTemplateItems ChecklistTemplateItem[]
  workOrders         WorkOrder[]
  assignments        WorkOrderAssignment[]
  statusHistory      WorkOrderStatusHistory[]
  comments           WorkOrderComment[]
  checklistItems     WorkOrderChecklistItem[]
  attachments        Attachment[]
  submissions        ResolutionSubmission[]
  slaPolicies        SlaPolicy[]
  slaEvents          SlaEvent[]
  schedules          MaintenanceSchedule[]
  notifications      Notification[]
  preferences        NotificationPreference[]
  auditLogs          AuditLog[]
  idempotencyRecords IdempotencyRecord[]
  outboxEvents       OutboxEvent[]
  emailDeliveries    EmailDelivery[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           Role
  status         MembershipStatus @default(ACTIVE)
  jobTitle       String?          @map("job_title") @db.VarChar(80)
  /// Technicians can mark themselves unavailable (leave, off shift); excluded from auto-assignment.
  isAvailable    Boolean          @default(true) @map("is_available")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       TechnicianSkill[]
  requested    WorkOrder[]           @relation("WorkOrderRequester")
  assigned     WorkOrder[]           @relation("WorkOrderAssignee")
  assignments  WorkOrderAssignment[] @relation("AssignmentAssignee")
  schedules    MaintenanceSchedule[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, role, status])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(254)
  role           Role
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  invitedById    String?   @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@map("invitations")
}

model TechnicianSkill {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  /// 1 = can assist, 2 = proficient, 3 = expert
  level          Int      @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  category     Category     @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Cascade)

  @@unique([membershipId, categoryId])
  @@index([organizationId, categoryId])
  @@map("technician_skills")
}

// ──────────────────────── Places and things ──────────────────────

/// One self-referencing hierarchy (site → building → floor → room/area). Parent types are
/// validated by the service layer using LOCATION_PARENT_RULES from @fixflow/shared.
model Location {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  parentId          String?      @map("parent_id") @db.Uuid
  type              LocationType
  name              String       @db.VarChar(120)
  code              String?      @db.VarChar(24)
  description       String?      @db.VarChar(200)
  /// Unguessable token printed in QR labels. Rotating it invalidates old labels.
  publicReportToken String       @unique @map("public_report_token") @db.VarChar(64)
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Location?             @relation("LocationTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children     Location[]            @relation("LocationTree")
  assets       Asset[]
  workOrders   WorkOrder[]
  schedules    MaintenanceSchedule[]

  @@unique([organizationId, id])
  @@index([organizationId, parentId])
  @@map("locations")
}

/// Single maintenance taxonomy used by work orders, assets (default issue type) and skills.
model Category {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String    @map("organization_id") @db.Uuid
  name                       String    @db.VarChar(60)
  description                String?   @db.VarChar(200)
  color                      String    @default("blue") @db.VarChar(16)
  icon                       String    @default("wrench") @db.VarChar(32)
  defaultChecklistTemplateId String?   @map("default_checklist_template_id") @db.Uuid
  archivedAt                 DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization             Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultChecklistTemplate ChecklistTemplate?    @relation(fields: [organizationId, defaultChecklistTemplateId], references: [organizationId, id], onDelete: Restrict)
  assets                   Asset[]
  workOrders               WorkOrder[]
  skills                   TechnicianSkill[]
  schedules                MaintenanceSchedule[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("categories")
}

model Asset {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  locationId        String      @map("location_id") @db.Uuid
  categoryId        String      @map("category_id") @db.Uuid
  name              String      @db.VarChar(120)
  assetTag          String      @map("asset_tag") @db.VarChar(40)
  status            AssetStatus @default(OPERATIONAL)
  manufacturer      String?     @db.VarChar(200)
  model             String?     @db.VarChar(200)
  serialNumber      String?     @map("serial_number") @db.VarChar(200)
  installDate       DateTime?   @map("install_date") @db.Timestamptz(3)
  warrantyExpiresAt DateTime?   @map("warranty_expires_at") @db.Timestamptz(3)
  notes             String?
  publicReportToken String      @unique @map("public_report_token") @db.VarChar(64)
  archivedAt        DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location              @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  category     Category              @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  workOrders   WorkOrder[]
  schedules    MaintenanceSchedule[]

  @@unique([organizationId, id])
  @@unique([organizationId, assetTag])
  @@index([organizationId, locationId])
  @@index([organizationId, status])
  @@map("assets")
}

model ChecklistTemplate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(80)
  description    String?   @db.VarChar(200)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ChecklistTemplateItem[]
  categories   Category[]
  schedules    MaintenanceSchedule[]

  @@unique([organizationId, id])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  templateId     String  @map("template_id") @db.Uuid
  label          String  @db.VarChar(200)
  required       Boolean @default(true)
  sortOrder      Int     @map("sort_order")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     ChecklistTemplate @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, templateId])
  @@map("checklist_template_items")
}

// ────────────────────────────── Work ─────────────────────────────

model WorkOrder {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  number         Int
  title          String          @db.VarChar(140)
  description    String          @default("")
  status         WorkOrderStatus @default(OPEN)
  priority       Priority        @default(MEDIUM)
  source         WorkOrderSource @default(WEB)
  categoryId     String          @map("category_id") @db.Uuid
  locationId     String?         @map("location_id") @db.Uuid
  assetId        String?         @map("asset_id") @db.Uuid
  /// Null for guest QR reports and preventive maintenance.
  requesterId    String?         @map("requester_id") @db.Uuid
  guestName      String?         @map("guest_name") @db.VarChar(80)
  guestContact   String?         @map("guest_contact") @db.VarChar(120)
  assigneeId     String?         @map("assignee_id") @db.Uuid
  scheduleId     String?         @map("schedule_id") @db.Uuid
  scheduledFor   DateTime?       @map("scheduled_for") @db.Timestamptz(3)

  // SLA snapshot for the current cycle (recomputed on priority change / reopen).
  slaCycle          Int       @default(0) @map("sla_cycle")
  cycleStartedAt    DateTime  @default(now()) @map("cycle_started_at") @db.Timestamptz(3)
  responseDueAt     DateTime  @map("response_due_at") @db.Timestamptz(3)
  resolutionDueAt   DateTime  @map("resolution_due_at") @db.Timestamptz(3)
  slaWarningPercent Int       @default(75) @map("sla_warning_percent") @db.SmallInt
  respondedAt       DateTime? @map("responded_at") @db.Timestamptz(3)
  /// submittedAt of the resolution that was approved (resolution SLA clock stop).
  resolutionSubmittedAt DateTime? @map("resolution_submitted_at") @db.Timestamptz(3)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(3)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(3)
  escalationLevel   Int       @default(0) @map("escalation_level") @db.SmallInt
  reopenCount       Int       @default(0) @map("reopen_count") @db.SmallInt
  reworkCount       Int       @default(0) @map("rework_count") @db.SmallInt

  /// Optimistic concurrency token; every mutation increments it.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category             @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  location     Location?            @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  asset        Asset?               @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  requester    Membership?          @relation("WorkOrderRequester", fields: [organizationId, requesterId], references: [organizationId, userId], onDelete: Restrict)
  assignee     Membership?          @relation("WorkOrderAssignee", fields: [organizationId, assigneeId], references: [organizationId, userId], onDelete: Restrict)
  schedule     MaintenanceSchedule? @relation(fields: [organizationId, scheduleId], references: [organizationId, id], onDelete: Restrict)

  assignments   WorkOrderAssignment[]
  statusHistory WorkOrderStatusHistory[]
  comments      WorkOrderComment[]
  checklist     WorkOrderChecklistItem[]
  attachments   Attachment[]
  submissions   ResolutionSubmission[]
  slaEvents     SlaEvent[]
  notifications Notification[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([scheduleId, scheduledFor])
  @@index([organizationId, status, priority])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, requesterId])
  @@index([organizationId, createdAt])
  @@index([organizationId, assetId])
  @@index([organizationId, locationId])
  @@index([status, responseDueAt])
  @@index([status, resolutionDueAt])
  @@map("work_orders")
}

model WorkOrderAssignment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  workOrderId    String           @map("work_order_id") @db.Uuid
  assigneeId     String           @map("assignee_id") @db.Uuid
  assignedById   String?          @map("assigned_by_id") @db.Uuid
  method         AssignmentMethod
  assignedAt     DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  unassignedAt   DateTime?        @map("unassigned_at") @db.Timestamptz(3)
  reason         String?          @db.VarChar(500)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)
  assignee     Membership   @relation("AssignmentAssignee", fields: [organizationId, assigneeId], references: [organizationId, userId], onDelete: Restrict)
  assignedBy   User?        @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([organizationId, workOrderId])
  @@index([organizationId, assigneeId])
  @@map("work_order_assignments")
}

model WorkOrderStatusHistory {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  workOrderId    String           @map("work_order_id") @db.Uuid
  fromStatus     WorkOrderStatus? @map("from_status")
  toStatus       WorkOrderStatus  @map("to_status")
  /// Null when performed by system automation.
  actorId        String?          @map("actor_id") @db.Uuid
  reason         String?          @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, workOrderId, createdAt])
  @@index([organizationId, toStatus, createdAt])
  @@map("work_order_status_history")
}

model WorkOrderComment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workOrderId    String    @map("work_order_id") @db.Uuid
  authorId       String?   @map("author_id") @db.Uuid
  body           String
  /// Staff-only notes are never returned to requesters.
  isInternal     Boolean   @default(false) @map("is_internal")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, workOrderId, createdAt])
  @@map("work_order_comments")
}

model WorkOrderChecklistItem {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workOrderId    String    @map("work_order_id") @db.Uuid
  label          String    @db.VarChar(200)
  required       Boolean   @default(true)
  sortOrder      Int       @map("sort_order")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  completedById  String?   @map("completed_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)
  completedBy  User?        @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@index([organizationId, workOrderId])
  @@map("work_order_checklist_items")
}

/// Stored privately in object storage under org/{organizationId}/…; served only via the API.
model Attachment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  workOrderId    String         @map("work_order_id") @db.Uuid
  submissionId   String?        @map("submission_id") @db.Uuid
  uploadedById   String?        @map("uploaded_by_id") @db.Uuid
  kind           AttachmentKind
  storageKey     String         @unique @map("storage_key") @db.VarChar(300)
  thumbnailKey   String?        @map("thumbnail_key") @db.VarChar(300)
  fileName       String         @map("file_name") @db.VarChar(200)
  contentType    String         @map("content_type") @db.VarChar(100)
  sizeBytes      Int            @map("size_bytes")
  width          Int?
  height         Int?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder             @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)
  submission   ResolutionSubmission? @relation(fields: [organizationId, submissionId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy   User?                 @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, workOrderId])
  @@map("attachments")
}

/// Technician's resolution evidence + its single verification outcome.
model ResolutionSubmission {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  workOrderId    String            @map("work_order_id") @db.Uuid
  submittedById  String            @map("submitted_by_id") @db.Uuid
  notes          String
  laborMinutes   Int?              @map("labor_minutes")
  partsUsed      String?           @map("parts_used")
  submittedAt    DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(3)
  outcome        SubmissionOutcome @default(PENDING)
  reviewedById   String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewNote     String?           @map("review_note") @db.VarChar(500)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)
  submittedBy  User         @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@unique([organizationId, id])
  @@index([organizationId, workOrderId])
  @@map("resolution_submissions")
}

// ──────────────────────── SLA and scheduling ─────────────────────

model SlaPolicy {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  priority          Priority
  responseMinutes   Int      @map("response_minutes")
  resolutionMinutes Int      @map("resolution_minutes")
  warningPercent    Int      @default(75) @map("warning_percent") @db.SmallInt
  escalationEnabled Boolean  @default(true) @map("escalation_enabled")
  description       String   @default("") @db.VarChar(240)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, priority])
  @@map("sla_policies")
}

/// Exactly-once record of an SLA warning/breach for one cycle of one work order.
model SlaEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workOrderId    String       @map("work_order_id") @db.Uuid
  type           SlaEventType
  cycle          Int
  dueAt          DateTime     @map("due_at") @db.Timestamptz(3)
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)

  @@unique([workOrderId, type, cycle])
  @@index([organizationId, occurredAt])
  @@map("sla_events")
}

model MaintenanceSchedule {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  title               String        @db.VarChar(140)
  description         String?
  categoryId          String        @map("category_id") @db.Uuid
  priority            Priority      @default(MEDIUM)
  assetId             String?       @map("asset_id") @db.Uuid
  locationId          String?       @map("location_id") @db.Uuid
  checklistTemplateId String?       @map("checklist_template_id") @db.Uuid
  defaultAssigneeId   String?       @map("default_assignee_id") @db.Uuid
  frequencyUnit       FrequencyUnit @map("frequency_unit")
  frequencyInterval   Int           @map("frequency_interval")
  startsAt            DateTime      @map("starts_at") @db.Timestamptz(3)
  nextDueAt           DateTime      @map("next_due_at") @db.Timestamptz(3)
  leadTimeDays        Int           @default(0) @map("lead_time_days")
  lastGeneratedAt     DateTime?     @map("last_generated_at") @db.Timestamptz(3)
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          Category           @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  asset             Asset?             @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  location          Location?          @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  checklistTemplate ChecklistTemplate? @relation(fields: [organizationId, checklistTemplateId], references: [organizationId, id], onDelete: Restrict)
  defaultAssignee   Membership?        @relation(fields: [organizationId, defaultAssigneeId], references: [organizationId, userId], onDelete: Restrict)
  workOrders        WorkOrder[]

  @@unique([organizationId, id])
  @@index([active, nextDueAt])
  @@map("maintenance_schedules")
}

// ─────────────────────────── Cross-cutting ───────────────────────

model Notification {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(200)
  body           String           @db.VarChar(1000)
  workOrderId    String?          @map("work_order_id") @db.Uuid
  /// Idempotency: the same logical notification is never stored twice for a user.
  dedupeKey      String           @map("dedupe_key") @db.VarChar(200)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?   @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([organizationId, userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  inApp          Boolean          @default(true) @map("in_app")
  email          Boolean          @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, type])
  @@map("notification_preferences")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(60)
  entityType     String   @map("entity_type") @db.VarChar(40)
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json     @default("{}")
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

/// Stores the response of a mutating request keyed by the client's Idempotency-Key,
/// so retried offline submissions replay instead of applying twice.
model IdempotencyRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(100)
  requestHash    String   @map("request_hash") @db.Char(64)
  statusCode     Int      @map("status_code") @db.SmallInt
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Transactional outbox: written in the same transaction as the business change and
/// dispatched to BullMQ by the worker (jobId = outbox id, so dispatch is idempotent).
model OutboxEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for account-level events (password reset, email verification) — system role only.
  organizationId String?      @map("organization_id") @db.Uuid
  type           String       @db.VarChar(60)
  aggregateId    String?      @map("aggregate_id") @db.Uuid
  payload        Json         @default("{}")
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError      String?      @map("last_error") @db.VarChar(1000)
  dispatchedAt   DateTime?    @map("dispatched_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailDeliveries EmailDelivery[]

  @@index([status, availableAt])
  @@map("outbox_events")
}

/// Exactly-once email: one row per (outbox event, recipient), status updated after sending.
model EmailDelivery {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String?   @map("organization_id") @db.Uuid
  outboxEventId     String    @map("outbox_event_id") @db.Uuid
  recipient         String    @db.VarChar(254)
  template          String    @db.VarChar(60)
  status            String    @default("PENDING") @db.VarChar(16)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(200)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outboxEvent  OutboxEvent   @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@unique([outboxEventId, recipient])
  @@map("email_deliveries")
}
