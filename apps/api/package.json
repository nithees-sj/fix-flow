{
  "name": "@fixflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@date-fns/tz": "^1.5.0",
    "@fixflow/db": "workspace:*",
    "@fixflow/shared": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.2.0",
    "@node-rs/argon2": "2.2.2",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "bullmq": "6.3.18",
    "cookie-parser": "1.4.7",
    "csv-stringify": "6.9.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "express": "5.3.0",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.7",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fixflow/config": "workspace:*",
    "@nestjs/cli": "12.0.9",
    "@nestjs/schematics": "12.0.9",
    "@nestjs/testing": "12.2.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "^10.13.0",
    "pg": "^8.23.1",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
